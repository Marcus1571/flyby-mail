# One entry per Mac: label=sha256 of that Mac's key. Make a key and its hash on the box, never paste keys into chat or git:
#   k=$(openssl rand -hex 24); echo "$k"   # this goes into that Mac's Keychain
#   printf %s "$k" | shasum -a 256         # first column goes here
FLYBY_KEYS=mac=<sha256-of-key-1>,macai=<sha256-of-key-2>
